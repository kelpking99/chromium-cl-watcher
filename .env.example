# Copy to .env for local runs. For GitHub Actions, put these same
# values in Settings > Secrets and variables > Actions instead.
# NEVER commit a real .env — it has passwords/tokens in it.

# Who to watch — Gerrit email is the most reliable identifier.
GERRIT_AUTHOR=kunaldaftari@google.com

# Comma-separated: console, email, telegram, sms-gateway
# Chosen: telegram (free and instant)
NOTIFY_MODE=telegram

# Email (Gmail SMTP). SMTP_PASS is a Google App Password, not your login password.
# Google Account > Security > 2-Step Verification > App passwords.
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
NOTIFY_EMAIL=you@gmail.com

# Telegram: create a bot with @BotFather, message it once, then
# curl https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMS gateway — only if you're on Verizon or Google Fi (see README warning).
SMS_GATEWAY_ADDRESS=4155551234@vtext.com
